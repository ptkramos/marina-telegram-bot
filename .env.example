# Token do seu Bot no Telegram (criado via @BotFather)
TELEGRAM_BOT_TOKEN="SEU_TOKEN_TELEGRAM_AQUI"

# Chave da API OpenAI (para a mente/conversas da Marin)
OPENAI_API_KEY="sk-..."

# Modelo OpenAI a utilizar (padrão econômico e rápido: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# URL pública do túnel Ngrok ou Pinggy que aponta para o Automatic1111 na sua máquina local
# Certifique-se de manter a barra '/' no final
SD_API_URL="https://seu-subdominio.ngrok-free.app/"

# Seu Chat ID do Telegram para que a Marin possa te mandar mensagens por iniciativa própria
# (Envie qualquer mensagem para o bot @userinfobot no Telegram para descobrir o seu ID numérico)
TARGET_CHAT_ID=123456789

# Intervalo em minutos para o ciclo de iniciativa própria da Marin
AUTONOMOUS_CHECK_INTERVAL_MINUTES=30

# Chance (0.0 a 1.0) de ela iniciar uma conversa no ciclo (ex: 0.25 = 25% de chance)
AUTONOMOUS_TRIGGER_CHANCE=0.25

NOVITA_VOICE_ID="voice_73e73b73-65be-4cf9-9ab6-35d84f1946a3"
NOVITA_VOICE_MODEL="speech-2.8-hd"
