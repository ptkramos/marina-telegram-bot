# ==============================================================================
# MARINA SELTIN v3.4.2 — ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo para .env e preencha com suas chaves. NUNCA envie o .env ao Git.
# ==============================================================================

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN="SEU_TOKEN_TELEGRAM_AQUI"
# Seu Chat ID numérico (exclusividade e segurança de acesso)
TARGET_CHAT_ID=123456789
MESSAGE_DEBOUNCE_SECONDS=3.8

# --- CÉREBRO & LLM (OpenRouter / OpenAI / Mistral / Llama) ---
LLM_API_KEY="sk-or-v1-..."
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="meta-llama/llama-3.3-70b-instruct"

# --- VOZ DA MARINA (Novita MiniMax Speech 2.8 HD / ElevenLabs Fallback) ---
NOVITA_API_KEY="sk_..."
NOVITA_VOICE_ID="voice_d91c415d-f6a2-4d6f-b32c-aacfd5ad2e39"
NOVITA_VOICE_MODEL="speech-2.8-hd"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# --- CÂMERA & GERAÇÃO DE IMAGENS (FLUX.1 Dev na Novita AI GPU) ---
IMAGE_ENGINE="novita"
NOVITA_INSTANCE_ID="e70d0a62c99c2402"
COMFYUI_URL=""
CIVITAI_API_KEY=""

# LoRAs de iPhone (Booster de Realismo e Mirror Selfie)
IPHONE_LORAS_ENABLED=true
IPHONE_PHOTO_LORA_NAME="iphone_photo_flux.safetensors"
MIRROR_SELFIE_LORA_NAME="mirror_selfie_flux.safetensors"
IPHONE_DEVICE_LORA_NAME="iphone16pro_flux.safetensors"

# --- PROATIVIDADE & INICIATIVA AUTÔNOMA ---
AUTONOMOUS_CHECK_INTERVAL_MINUTES=30
AUTONOMOUS_TRIGGER_CHANCE=0.35

# --- SMART MEMORY & CONSOLIDAÇÃO ---
SMART_MEMORY_ENABLED=true
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_BATCH_SIZE=8

# --- AUTO-PATCHER SEGURO ---
SAFE_PATCHER_ENABLED=false
